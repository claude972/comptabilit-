# Secrets LOCAUX générés le 2026-11-19. Ne pas réutiliser hors de ce poste.
PG_ADMIN_USER=comtaple_admin
PG_ADMIN_PASSWORD=<généré par scripts/generer-env.sh>
PG_APP_PASSWORD=<généré par scripts/generer-env.sh>
PG_WORKER_PASSWORD=<généré par scripts/generer-env.sh>
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=comtaple
REDIS_PASSWORD=<généré par scripts/generer-env.sh>
REDIS_URL=<généré par scripts/generer-env.sh>
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=local
S3_BUCKET=comtaple-dev
S3_ACCESS_KEY=<généré par scripts/generer-env.sh>
S3_SECRET_KEY=<généré par scripts/generer-env.sh>
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=<généré par scripts/generer-env.sh>
OIDC_ISSUER=http://localhost:8080/realms/comtaple
OIDC_CLIENT_ID=comtaple-web
OIDC_CLIENT_SECRET=<généré par scripts/generer-env.sh>
OIDC_AUDIENCE=comtaple-api
SESSION_SECRET=<généré par scripts/generer-env.sh>
JETONS_CLE_CHIFFREMENT=<généré par scripts/generer-env.sh>
# Rotation : anciens secrets, séparés par des virgules, acceptés pour déchiffrer seulement (vide en temps normal).
JETONS_CLES_ANCIENNES=
API_URL=http://127.0.0.1:4000
WEB_URL=http://localhost:3100
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
OCR_URL=http://127.0.0.1:8500
ANTIVIRUS_OBLIGATOIRE=true
# Passerelle IA : laisser vide = statut « non connecté » (aucun appel sortant).
IA_OVH_ENDPOINT=
IA_OVH_JETON=
# Tarifs IA DATÉS pour l'estimation de coût (JSON) ; vide = coût non estimé. Exemple de forme :
# IA_TARIFS={"relevesLe":"AAAA-MM-JJ","devise":"EUR","source":"<page du catalogue>","parMillionDeJetons":{"<modèle>":{"entree":"0.00","sortie":"0.00"}}}
IA_TARIFS=
# Collecte par mail (@comtaple/mail). Identifiants OAuth VIDES = connecteurs « non connectés », aucune connexion possible.
# Voir packages/mail/docs/guide-connexion.md. Ne JAMAIS définir MAIL_SIMULATEUR_URL hors des tests (refusé en production).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SUJET_PUBSUB=
GOOGLE_PUSH_AUDIENCE=
GOOGLE_PUSH_COMPTE_SERVICE=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_LOCATAIRE=common
MAIL_URI_REDIRECTION=
MAIL_URL_PUBLIQUE_API=
MAIL_PERIODE_RATTRAPAGE_S=900
DEV_MDP_UTILISATEURS=<généré par scripts/generer-env.sh>
