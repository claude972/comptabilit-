    "/v1/documents/{id}/extraction": {
      "put": {
        "description": "Les vérifications arithmétiques sont recalculées par le moteur déterministe. Le résultat reste un projet jusqu’à validation.",
        "operationId": "DocumentsController_corriger",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "champs": {
                    "type": "object",
                    "properties": {
                      "typeDocument": {
                        "type": "string",
                        "enum": [
                          "facture",
                          "avoir",
                          "inconnu"
                        ]
                      },
                      "numero": {
                        "type": "string",
                        "maxLength": 100
                      },
                      "dateEmission": {
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      "dateEcheance": {
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      "emetteurNom": {
                        "type": "string",
                        "maxLength": 200
                      },
                      "emetteurSiren": {
                        "type": "string",
                        "maxLength": 20
                      },
                      "emetteurSiret": {
                        "type": "string",
                        "maxLength": 20
                      },
                      "emetteurTva": {
                        "type": "string",
                        "maxLength": 20
                      },
                      "totalHt": {
                        "type": "string",
                        "pattern": "^-?\\d{1,13}(\\.\\d{1,6})?$"
                      },
                      "totalTva": {
                        "type": "string",
                        "pattern": "^-?\\d{1,13}(\\.\\d{1,6})?$"
                      },
                      "totalTtc": {
                        "type": "string",
                        "pattern": "^-?\\d{1,13}(\\.\\d{1,6})?$"
                      },
                      "devise": {
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 3
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "required": [
                  "champs"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Corriger des champs extraits : crée une nouvelle version de l’extraction (les versions précédentes sont conservées)",
        "tags": [
          "Documents"
        ]
      }
    },
    "/v1/documents/{id}/validation": {
      "post": {
        "description": "La validation porte sur une version déterminée de l’extraction ; toute correction ultérieure crée une nouvelle version non validée.",
