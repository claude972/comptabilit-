# EXEMPLE d'environnement de la supervision en PRODUCTION (valeurs factices). Le vrai fichier (`supervision.env`) vit
# sur l'instance de supervision, hors du dépôt, lisible par son seul propriétaire.
ENVIRONNEMENT=production
REGISTRE=registre.exemple.test/comtaple
VERSION=0000000
GRAFANA_MDP_ADMIN=factice-mot-de-passe-grafana
PROMETHEUS_RETENTION=30d

# Cibles : port de collecte PRIVÉ du proxy de l'instance applicative (infra/production/compose.production.yaml).
CIBLE_API=10.20.0.10:9100
CHEMIN_API=/api/metrics
CIBLE_WORKER=10.20.0.10:9100
CHEMIN_WORKER=/worker/metrics
CIBLE_REDIS=10.20.0.10:9100
CHEMIN_REDIS=/redis/metrics
CIBLE_HOTE=10.20.0.10:9100
CHEMIN_HOTE=/hote/metrics
CIBLE_KEYCLOAK=10.20.0.10:9100
CHEMIN_KEYCLOAK=/keycloak/metrics

# ── Traces : entrepôt (Tempo) ──
# Rétention courte et bornée. Taille maximale reçue = débit × rétention (8 000 o/s × 72 h ≈ 2,1 Go avant compression) :
# à garder SOUS l'espace disque libre de l'instance ; l'occupation réelle n'a pas été mesurée sous charge.
TEMPO_RETENTION=72h
TEMPO_DEBIT_OCTETS_S=8000
TEMPO_RAFALE_OCTETS=4000000

# ── Traces : entrée depuis l'instance applicative (réseau privé, TLS mutuel) ──
# Sans ces lignes, l'entrée n'existe pas : aucun port n'est ouvert hors de 127.0.0.1. Pour l'ACTIVER, poser ensemble
# COMPOSE_PROFILES=acheminement, l'adresse PRIVÉE de cette instance et les trois PEM (entre guillemets doubles, sur
# plusieurs lignes). Génération : docs/exploitation.md, § 9. La clé du serveur est un SECRET.
# COMPOSE_PROFILES=acheminement
ADRESSE_PRIVEE_SUPERVISION=10.20.0.20
TRACES_PORT_ENTREE=4319
TRACES_AC_PEM=
TRACES_ENTREE_CERT_PEM=
TRACES_ENTREE_CLE_PEM=
