# EXEMPLE de fichier d'environnement de production. TOUTES les valeurs sont FACTICES (« factice-… », domaines en
# « .exemple.test ») : ce fichier ne sert qu'à valider la composition (`docker compose config`) et à lister les
# variables attendues. Le vrai fichier (`production.env`) vit sur l'hôte, hors du dépôt, lisible par son seul
# propriétaire (chmod 600), et ne doit jamais être versionné. Génération des secrets : docs/exploitation.md.

# ── Images (posées par scripts/deployer.sh) ──
REGISTRE=registre.exemple.test/comtaple
VERSION=0000000

# ── Noms publics et réseau ──
DOMAINE_WEB=app.exemple.test
DOMAINE_AUTH=auth.exemple.test
ACME_COURRIEL=exploitation@exemple.test
# Adresse de l'instance dans le réseau privé (collecte des métriques par l'instance de supervision).
ADRESSE_PRIVEE=10.20.0.10
# Plages autorisées à atteindre la console d'administration de Keycloak (séparées par des espaces).
ADMIN_PLAGES_AUTORISEES=192.0.2.10/32

# ── Base PostgreSQL managée ──
PG_HOST=postgresql-factice.exemple.test
PG_PORT=20184
PG_DATABASE=comtaple
PGSSLMODE=require
# Autorité de certification de la base (PEM, entre guillemets doubles sur plusieurs lignes) ; vide si publique.
PG_AC_PEM=
PG_APP_PASSWORD=factice-mot-de-passe-app
PG_WORKER_PASSWORD=factice-mot-de-passe-worker
# PG_ADMIN_USER / PG_ADMIN_PASSWORD (rôle de migration) ne figurent PAS ici : ils ne sont fournis qu'à la commande de
# migration, par scripts/deployer.sh, à partir d'un fichier séparé (migration.env).

# ── Analyse isolée en conteneurs (D-098) : DÉSACTIVÉE par défaut ──
# `processus` : analyseurs dans un processus enfant du worker (défaut). `conteneur` : un conteneur dédié par fichier ; exige le
# profil `analyse-conteneur` (lanceur restreint), WORKER_VARIANTE=-conteneurs, DOCKER_GID (groupe du socket du moteur) et ANALYSE_CONTENEUR_HOTE.
ANALYSE_ISOLATION=processus
# WORKER_VARIANTE=-conteneurs
# ANALYSE_CONTENEUR_HOTE=unix:///run/lanceur/docker.sock
# DOCKER_GID=988

# ── Files ──
REDIS_PASSWORD=factice-mot-de-passe-redis

# ── Stockage objet S3 (OVHcloud, région française) ──
S3_ENDPOINT=https://s3.gra.io.cloud.ovh.net
S3_REGION=gra
S3_BUCKET=comtaple-production-documents
S3_ACCESS_KEY=factice-cle-acces
S3_SECRET_KEY=factice-cle-secrete

# ── Identités ──
OIDC_CLIENT_SECRET=factice-secret-client-oidc
SESSION_SECRET=factice-secret-de-session-de-quarante-huit-caracteres-au-moins
KC_DB_HOST=postgresql-factice.exemple.test
KC_DB_PORT=20184
KC_DB_NAME=keycloak
KC_DB_SSLMODE=require
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=factice-mot-de-passe-keycloak
# Compte d'amorçage de Keycloak : à DÉCOMMENTER pour le premier démarrage seulement, puis à SUPPRIMER (ne pas laisser
# ces variables vides : Keycloak refuse alors de démarrer).
# KC_BOOTSTRAP_ADMIN_USERNAME=amorce
# KC_BOOTSTRAP_ADMIN_PASSWORD=factice-mot-de-passe-amorce

# ── Collecte par mail (vide = connecteurs « non connectés ») ──
JETONS_CLE_CHIFFREMENT=factice-secret-des-jetons-de-quarante-trois-caracteres
# Rotation : anciens secrets, séparés par des virgules, acceptés pour déchiffrer seulement (vide en temps normal).
JETONS_CLES_ANCIENNES=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SUJET_PUBSUB=
GOOGLE_PUSH_AUDIENCE=
GOOGLE_PUSH_COMPTE_SERVICE=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_LOCATAIRE=common
MAIL_URI_REDIRECTION=
MAIL_URL_PUBLIQUE_API=

# ── Amortissement DÉGRESSIF : calcul NON ACTIVÉ par défaut (false) ──
# Texte de loi (CGI art. 39 A) non vérifié sur une source officielle, règles non validées par un professionnel : ne passer à true
# qu'après vérification sur Légifrance et validation par un expert-comptable (docs/etats-fiscaux.md, « Activer le dégressif »).
AMORTISSEMENT_DEGRESSIF_ACTIVE=false

# ── Plafonds des calculs immédiats de l'API (D-093) : au-delà, REFUS motivé (409), jamais un résultat partiel ni une erreur 500 ──
# Variables de l'API seule. Le plafond de lignes va avec le tas de l'API (--max-old-space-size, 768 Mo dans l'image, conteneur de 1 Go) :
# 264 957 lignes réussissent avec un tas de 384 Mo et font tomber l'API à 320 Mo ; relever un plafond sans relever le tas (et la
# mémoire du conteneur) déplace le problème. Mesures : docs/rapport-de-tests.md ; tableau route → borne : docs/exploitation.md.
API_LIGNES_MAX_CALCUL=300000
API_LIGNES_MAX_IMPACT_REGLE=200000
API_LIGNES_MAX_PORTEFEUILLE_DOSSIER=100000
API_LIGNES_MAX_SIMULTANEES=300000
API_MOUVEMENTS_MAX_CALCUL=400000
API_PIECES_MAX_TIERS=5000
API_CONSTATS_MAX_REVUE=20000
API_TAS_MAX_MO=768

# ── Notifications poussées discrètes (vide = DÉSACTIVÉES, aucun envoi vers les services de notification des navigateurs) ──
# Les trois vont ensemble. Paire générée par `node scripts/cles-vapid.mjs "mailto:…"` ; clé privée dans le coffre de
# secrets seulement. Ne pas activer avant validation (docs/exploitation.md ; docs/juridique/sous-traitants.md).
PUSH_VAPID_CLE_PUBLIQUE=
PUSH_VAPID_CLE_PRIVEE=
PUSH_VAPID_SUJET=

# ── Passerelle IA (vide = « non connectée », aucun appel sortant) ──
IA_OVH_ENDPOINT=
IA_OVH_JETON=

# ── Traces OpenTelemetry (docs/exploitation.md, § 9) ──
# VIDE (défaut) = aucune trace, aucun appel réseau, pas d'agent. Pour ACTIVER, poser ensemble :
#   COMPOSE_PROFILES=traces                                  (démarre le service `agent-traces`)
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://agent-traces:4318     (l'API et le worker exportent vers l'agent, même hôte)
#   TRACES_ENTREE_SUPERVISION=https://10.20.0.20:4319        (adresse PRIVÉE de l'instance de supervision)
# et les trois PEM ci-dessous (entre guillemets doubles, sur plusieurs lignes). Génération de l'autorité privée et des
# certificats : docs/exploitation.md, § 9. La clé de l'agent est un SECRET ; l'autorité et le certificat sont publics.
OTEL_EXPORTER_OTLP_ENDPOINT=
TRACES_ENTREE_SUPERVISION=
TRACES_AC_PEM=
TRACES_AGENT_CERT_PEM=
TRACES_AGENT_CLE_PEM=
# Part des traces enregistrées (0 à 1) et nom de l'environnement porté par les traces.
TRACES_TAUX_ECHANTILLONNAGE=0.1
TRACES_ENVIRONNEMENT=production
