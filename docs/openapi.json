    "/v1/televersements": {
      "post": {
        "description": "Le client annonce la taille et l’empreinte SHA-256 du fichier. Si un téléversement identique est déjà ouvert pour ce déposant, il est renvoyé avec le nombre d’octets déjà reçus : le client reprend à cet endroit.",
        "operationId": "TeleversementsController_ouvrir",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "entiteId": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "nomFichier": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255
                  },
                  "taille": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "typeMime": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "canal": {
                    "type": "string",
                    "enum": [
                      "telephone",
                      "ordinateur"
                    ]
                  },
                  "usage": {
                    "default": "piece",
                    "type": "string",
                    "enum": [
                      "piece",
                      "fec"
                    ]
                  },
                  "nature": {
                    "default": "a_qualifier",
                    "type": "string",
                    "enum": [
                      "facture_achat",
                      "facture_vente",
                      "avoir",
                      "releve_bancaire",
                      "lettre_mission",
                      "contrat",
                      "autre",
                      "a_qualifier"
                    ]
                  },
                  "commentaire": {
                    "type": "string",
                    "maxLength": 2000
                  },
                  "exerciceId": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "statutDonnees": {
                    "type": "string",
                    "enum": [
                      "travail_avant_cloture",
                      "fec"
                    ]
                  }
                },
                "required": [
                  "entiteId",
                  "nomFichier",
                  "taille",
                  "sha256",
                  "canal",
                  "usage",
                  "nature"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Ouvre (ou reprend) un téléversement reprenable",
        "tags": [
          "Téléversements"
        ]
      }
    },
    "/v1/televersements/{id}": {
