{
  "name": "comtaple",
  "private": true,
  "version": "0.1.0",
  "description": "Couche de contrôle, de préparation et de preuve pour cabinets d'expertise comptable",
  "packageManager": "pnpm@12.21.0",
  "engines": { "node": ">=24.22.0 <25" },
  "type": "module",
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:integration": "pnpm -r run test:integration",
    "db:migrate": "pnpm --filter @comtaple/db run migrate",
    "db:seed": "pnpm --filter @comtaple/db run seed",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose down"
  }
}
