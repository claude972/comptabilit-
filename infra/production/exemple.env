# EXEMPLE de fichier d'environnement de production. TOUTES les valeurs sont FACTICES (« factice-… », domaines en
# « .exemple.test ») : ce fichier ne sert qu'à valider la composition (`docker compose config`) et à lister les
# variables attendues. Le vrai fichier (`production.env`) vit sur l'hôte, hors du dépôt, lisible par son seul
# propriétaire (chmod 600), et ne doit jamais être versionné. Génération des secrets : docs/exploitation.md.

# ── Images (posées par scripts/deployer.sh) ──
REGISTRE=registre.exemple.test/comtaple
VERSION=0000000

# ── Noms publics et réseau ──
DOMAINE_WEB=app.exemple.test
DOMAINE_AUTH=auth.exemple.test
ACME_COURRIEL=exploitation@exemple.test
# Adresse de l'instance dans le réseau privé (collecte des métriques par l'instance de supervision).
ADRESSE_PRIVEE=10.20.0.10
# Plages autorisées à atteindre la console d'administration de Keycloak (séparées par des espaces).
ADMIN_PLAGES_AUTORISEES=192.0.2.10/32

# ── Base PostgreSQL managée ──
PG_HOST=postgresql-factice.exemple.test
PG_PORT=20184
PG_DATABASE=comtaple
PGSSLMODE=require
# Autorité de certification de la base (PEM, entre guillemets doubles sur plusieurs lignes) ; vide si publique.
PG_AC_PEM=
PG_APP_PASSWORD=factice-mot-de-passe-app
PG_WORKER_PASSWORD=factice-mot-de-passe-worker
# PG_ADMIN_USER / PG_ADMIN_PASSWORD (rôle de migration) ne figurent PAS ici : ils ne sont fournis qu'à la commande de
# migration, par scripts/deployer.sh, à partir d'un fichier séparé (migration.env).

# ── Files ──
REDIS_PASSWORD=factice-mot-de-passe-redis

# ── Stockage objet S3 (OVHcloud, région française) ──
S3_ENDPOINT=https://s3.gra.io.cloud.ovh.net
S3_REGION=gra
S3_BUCKET=comtaple-production-documents
S3_ACCESS_KEY=factice-cle-acces
S3_SECRET_KEY=factice-cle-secrete

# ── Identités ──
OIDC_CLIENT_SECRET=factice-secret-client-oidc
SESSION_SECRET=factice-secret-de-session-de-quarante-huit-caracteres-au-moins
KC_DB_HOST=postgresql-factice.exemple.test
KC_DB_PORT=20184
KC_DB_NAME=keycloak
KC_DB_SSLMODE=require
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=factice-mot-de-passe-keycloak
# Compte d'amorçage de Keycloak : à DÉCOMMENTER pour le premier démarrage seulement, puis à SUPPRIMER (ne pas laisser
# ces variables vides : Keycloak refuse alors de démarrer).
# KC_BOOTSTRAP_ADMIN_USERNAME=amorce
# KC_BOOTSTRAP_ADMIN_PASSWORD=factice-mot-de-passe-amorce

# ── Collecte par mail (vide = connecteurs « non connectés ») ──
JETONS_CLE_CHIFFREMENT=factice-secret-des-jetons-de-quarante-trois-caracteres
# Rotation : anciens secrets, séparés par des virgules, acceptés pour déchiffrer seulement (vide en temps normal).
JETONS_CLES_ANCIENNES=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SUJET_PUBSUB=
GOOGLE_PUSH_AUDIENCE=
GOOGLE_PUSH_COMPTE_SERVICE=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_LOCATAIRE=common
MAIL_URI_REDIRECTION=
MAIL_URL_PUBLIQUE_API=

# ── Passerelle IA (vide = « non connectée », aucun appel sortant) ──
IA_OVH_ENDPOINT=
IA_OVH_JETON=

# ── Traces OpenTelemetry (docs/exploitation.md, § 9) ──
# Point d'accès OTLP/HTTP du collecteur, ex. http://10.20.0.20:4318 ; VIDE = aucune trace, aucun appel réseau.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Part des traces enregistrées (0 à 1) et nom de l'environnement porté par les traces.
TRACES_TAUX_ECHANTILLONNAGE=0.1
TRACES_ENVIRONNEMENT=production
