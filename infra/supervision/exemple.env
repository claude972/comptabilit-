# EXEMPLE d'environnement de la supervision en PRODUCTION (valeurs factices). Le vrai fichier (`supervision.env`) vit
# sur l'instance de supervision, hors du dépôt, lisible par son seul propriétaire.
ENVIRONNEMENT=production
REGISTRE=registre.exemple.test/comtaple
VERSION=0000000
GRAFANA_MDP_ADMIN=factice-mot-de-passe-grafana
PROMETHEUS_RETENTION=30d

# Cibles : port de collecte PRIVÉ du proxy de l'instance applicative (infra/production/compose.production.yaml).
CIBLE_API=10.20.0.10:9100
CHEMIN_API=/api/metrics
CIBLE_WORKER=10.20.0.10:9100
CHEMIN_WORKER=/worker/metrics
CIBLE_REDIS=10.20.0.10:9100
CHEMIN_REDIS=/redis/metrics
CIBLE_HOTE=10.20.0.10:9100
CHEMIN_HOTE=/hote/metrics
CIBLE_KEYCLOAK=10.20.0.10:9100
CHEMIN_KEYCLOAK=/keycloak/metrics
