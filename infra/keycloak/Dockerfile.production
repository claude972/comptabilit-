# Image Keycloak de PRODUCTION : configuration de construction figée (`kc.sh build`), démarrage par
# `start --optimized`. Construction (contexte : infra/keycloak) :
#   docker build -f infra/keycloak/Dockerfile.production -t comtaple-keycloak:<version> infra/keycloak
# Le gabarit du royaume est embarqué SANS secret ni compte : ses valeurs variables (`${OIDC_CLIENT_SECRET}`,
# `${WEB_URL}`) sont lues dans l'environnement du conteneur au moment de l'import. `--import-realm` n'importe le
# royaume que s'il n'existe pas encore : un royaume existant n'est jamais écrasé.
FROM quay.io/keycloak/keycloak:26.8.2 AS construction
ENV KC_DB=postgres \
    KC_HEALTH_ENABLED=true \
    KC_METRICS_ENABLED=true
RUN /opt/keycloak/bin/kc.sh build

FROM quay.io/keycloak/keycloak:26.8.2
COPY --from=construction /opt/keycloak/ /opt/keycloak/
COPY realm-comtaple-production.gabarit.json /opt/keycloak/data/import/realm-comtaple.json
ENV KC_DB=postgres \
    KC_HEALTH_ENABLED=true \
    KC_METRICS_ENABLED=true
ENTRYPOINT ["/opt/keycloak/bin/kc.sh"]
CMD ["start", "--optimized", "--import-realm"]
