{
  "name": "@comtaple/core",
  "version": "0.1.0",
  "private": true,
  "description": "Moteur métier déterministe et pur de Comtaple (montants, identifiants, FEC, contrôles de révision, extraction de factures, jeux synthétiques)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "docs"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "decimal.js": "10.6.0",
    "fast-xml-parser": "5.12.1",
    "iconv-lite": "0.7.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
