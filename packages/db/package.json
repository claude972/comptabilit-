{
  "name": "@comtaple/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./env": {
      "types": "./dist/env.d.ts",
      "default": "./dist/env.js"
    },
    "./amorcer": {
      "types": "./dist/amorcer.d.ts",
      "default": "./dist/amorcer.js"
    },
    "./provisionnement": {
      "types": "./dist/provisionnement.d.ts",
      "default": "./dist/provisionnement.js"
    },
    "./ancre-journal": {
      "types": "./dist/ancre-journal.d.ts",
      "default": "./dist/ancre-journal.js"
    },
    "./durees-conservation": {
      "types": "./dist/durees-conservation.d.ts",
      "default": "./dist/durees-conservation.js"
    },
    "./simulation-conservation": {
      "types": "./dist/simulation-conservation.d.ts",
      "default": "./dist/simulation-conservation.js"
    },
    "./objets-fin-de-contrat": {
      "types": "./dist/objets-fin-de-contrat.d.ts",
      "default": "./dist/objets-fin-de-contrat.js"
    },
    "./comptes-fin-de-contrat": {
      "types": "./dist/comptes-fin-de-contrat.d.ts",
      "default": "./dist/comptes-fin-de-contrat.js"
    },
    "./migrer": {
      "types": "./dist/migrer.d.ts",
      "default": "./dist/migrer.js"
    },
    "./base-jetable": {
      "types": "./dist/base-jetable.d.ts",
      "default": "./dist/base-jetable.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrer.ts",
    "seed": "tsx src/amorcer.ts",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@comtaple/core": "workspace:*",
    "@opentelemetry/api": "1.10.0",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
